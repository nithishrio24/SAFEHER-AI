# SafeHer AI Environment Variables
# Copy this file to .env and fill in your actual API keys

# Fast2SMS Configuration (for SMS notifications)
FAST2SMS_KEY=your_fast2sms_api_key_here
ALERT_PHONE=your_alert_phone_number_here

# Gmail Email Configuration (for email alerts)
GMAIL_USER=your_gmail_address_here
GMAIL_PASSWORD=your_gmail_app_password_here
ALERT_TO_EMAILS=recipient_email_address_here

# Gemini AI Configuration (for AI-powered distress detection)
# Get FREE API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (for push notifications)
FIREBASE_KEY=your_firebase_server_key_here

# Google Maps Configuration (for finding nearby emergency services)
GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Optional: Database Configuration (if using a database in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/safeher_ai
# REDIS_URL=redis://localhost:6379/0

# Optional: Application Configuration
# LOG_LEVEL=INFO
# ENVIRONMENT=development
